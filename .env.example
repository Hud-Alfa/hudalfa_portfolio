# Spotify — hero'daki "son dinlediğim" rozeti için.
# 1. https://developer.spotify.com/dashboard üzerinde bir uygulama oluştur.
# 2. Redirect URI olarak tam olarak şunu ekle: http://127.0.0.1:8888/callback
# 3. Client ID ve secret'ı .env.local dosyasına yaz, sonra: npm run spotify:auth
#    Betik izin akışını yürütüp refresh token'ı .env.local'e kendisi yazar.
# 4. Aynı üç değeri Vercel'de Environment Variables altına gir.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Kimlik bilgileri girilmeden rozeti yerelde görmek için: SPOTIFY_DEMO=1
# Sadece geliştirmede ve sadece yukarıdaki üç değer boşken çalışır.
SPOTIFY_DEMO=

# GitHub — arşiv ızgarası için. Zorunlu değil; token verilmezse
# API saatlik 60 istek sınırıyla çalışır, ki derleme anı için yeterlidir.
# Verilirse sınır 5000'e çıkar. Hiçbir izin (scope) gerekmez.
GITHUB_TOKEN=

# Web3Forms — iletişim formu. Anahtar tarayıcıya iner, gizli değildir.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Anthropic: hero fotoğrafındaki "Asistana sor" sohbeti için.
# https://console.anthropic.com adresinden bir API anahtarı oluştur, Vercel'de
# ANTHROPIC_API_KEY olarak gir ve yeniden yayınla. Boşsa canlı sitede düğme
# görünmez; geliştirmede asistan yalnızca bulduğu kaynakları listeleyen bir deneme yanıtı verir.
ANTHROPIC_API_KEY=
